<Slide style={{
    width: 1280,
    height: 720,
    background: '#FFFFFF',
    padding: '60px 60px',
    flexDirection: 'column',
    fontFamily: '"Arial", "Microsoft YaHei", sans-serif',
}}>
    <Text style={{ fontSize: 13, color: '#3D7BD9', fontWeight: 'bold', letterSpacing: 1.6 }}>
        CONCLUSION
    </Text>
    <Text style={{ fontFamily: 'Georgia, serif', fontSize: 46, fontWeight: 'bold', color: '#0E3F8C', lineHeight: 1.18, marginTop: 12 }}>
        A negative result, by design
    </Text>
    <Box style={{ height: 1, background: '#D6DCE5', marginTop: 16 }} />

    <Text style={{ fontSize: 22, color: '#1A2230', lineHeight: 1.5, marginTop: 26 }}>
        The gap between a reproducible transparent model and the closing market is
        information, not a calibration defect we could have repaired.
    </Text>

    <Box style={{ flexDirection: 'row', gap: 20, marginTop: 30 }}>
        <Box style={{ flex: 1, padding: '18px 20px', background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 6 }}>
            <Text style={{ fontSize: 13, color: '#3D7BD9', fontWeight: 'bold', letterSpacing: 1.2 }}>LIMIT 01</Text>
            <Text style={{ fontSize: 17, color: '#1A2230', lineHeight: 1.5, marginTop: 8 }}>
                One sport, six leagues — and Pinnacle closing prices only.
            </Text>
        </Box>
        <Box style={{ flex: 1, padding: '18px 20px', background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 6 }}>
            <Text style={{ fontSize: 13, color: '#3D7BD9', fontWeight: 'bold', letterSpacing: 1.2 }}>LIMIT 02</Text>
            <Text style={{ fontSize: 17, color: '#1A2230', lineHeight: 1.5, marginTop: 8 }}>
                Closing odds only — no opening, no in-play prices, no other bookmakers.
            </Text>
        </Box>
        <Box style={{ flex: 1, padding: '18px 20px', background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 6 }}>
            <Text style={{ fontSize: 13, color: '#3D7BD9', fontWeight: 'bold', letterSpacing: 1.2 }}>LIMIT 03</Text>
            <Text style={{ fontSize: 17, color: '#1A2230', lineHeight: 1.5, marginTop: 8 }}>
                48 blocks resolve differences above 0.02 nats — nothing finer.
            </Text>
        </Box>
    </Box>

    <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', marginTop: 28, padding: '16px 20px', background: '#F0F5FC', borderRadius: 6 }}>
        <Text style={{ fontSize: 16, color: '#1A2230' }}>
            One command rebuilds every number on these slides:
        </Text>
        <Text style={{ fontSize: 16, color: '#0E3F8C', fontWeight: 'bold', letterSpacing: 0.4 }}>
            python -m src.eval.run_m2
        </Text>
    </Box>

    <Box style={{ flex: 1 }} />

    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
        <Text style={{ fontFamily: 'Georgia, serif', fontSize: 30, color: '#0E3F8C', fontWeight: 'bold' }}>
            Thank you
        </Text>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>
            Team 32 · 24 November 2026
        </Text>
    </Box>
</Slide>
