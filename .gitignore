# =============================================================================
# Football-Calibration / .gitignore
# 建立日期：2026-11-07    版本：v1.2（2026-11-07 更新）
#
# 约定：**data/raw/ 的原始 CSV 快照已入库**（132 个文件 / 约 14 MB），全组 clone
#       即用、无需各自重新下载；data/ 的其余子目录（interim / processed /
#       external）以及 Agent/工具自动生成且不需版本控制的内容，一律不入库。
#       **使用 Agent 的组员，必须自行把该工具新生成的、不需要参与版本控制的
#       所有文件或文件夹补进本文件，并把这次修改一起提交。**（见 README §4.2）
#
# 维护：新增/删除任何忽略规则，须同步更新根目录 README §4.1。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 数据
#    data/raw/ 的 132 个原始 CSV 是**有意入库**的：体积可控（14 MB，最大单文件
#    197 KB），且能让全组从同一个 commit 拿到字节完全一致的快照。原始文件为
#    CRLF + UTF-8 BOM，字节级一致性由根目录 .gitattributes 的 `-text` 与
#    configs/raw_manifest.csv 的 SHA256 共同保证（见 README §3.4）。
#    data/ 其余子目录只放可再生的大文件，不入库，仅保留 .gitkeep 占位。
# -----------------------------------------------------------------------------
/data/*
!/data/.gitkeep
# data/missing.csv 是 T1.1 的「0 缺失」审计凭据（仅表头），须随仓库分发（README §3.2）
!/data/missing.csv
!/data/raw/
!/data/interim/
!/data/processed/
!/data/external/
/data/interim/*
!/data/interim/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/data/external/*
!/data/external/.gitkeep

# 显式声明 raw 下的 CSV 一律入库（防止将来新增 *.csv 全局忽略规则时误伤）
!/data/raw/*.csv

# 体量较大 / 二进制的数据格式（无论放在哪个目录都不入库）
*.parquet
*.feather
*.arrow
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.npy
*.npz
*.db
*.sqlite
*.sqlite3
*.duckdb
*.pt
*.pth
*.onnx

# 注意：*.csv / *.json / *.xlsx 故意不做全局忽略 ——
# data/raw/ 的原始快照、configs/ 的契约表、results/ 的预测表、
# products/tables/ 的成品表都需要入库。

# -----------------------------------------------------------------------------
# 2. 项目约定忽略的目录
# -----------------------------------------------------------------------------
CHARGED/
charged/
/CHARGED/

# -----------------------------------------------------------------------------
# 3. Agent / AI 编码工具自动生成的目录与文件
#    （清单不穷尽；使用者按 README §4.2 自行补全）
# -----------------------------------------------------------------------------
.workbuddy/
.tools/
scripts/
.claude/
.cursor/
.codex/
.aider*
.continue/
.windsurf/
.roo/
.kiro/
.gemini/
.qwen/
.trae/
.cline/
.serena/
.agent/
.mcp/
AGENTS.local.md
CLAUDE.local.md

# -----------------------------------------------------------------------------
# 4. Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
sdist/
wheels/
*.egg
.installed.cfg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ipynb_checkpoints/

# 虚拟环境
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# -----------------------------------------------------------------------------
# 5. 环境变量 / 密钥
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json

# -----------------------------------------------------------------------------
# 6. IDE / 操作系统
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.code-workspace
*.iml
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# 7. 日志 / 缓存 / 临时文件
# -----------------------------------------------------------------------------
*.log
/logs/
tmp/
temp/
.cache/
cache/
*.tmp
*.bak
*.orig

# -----------------------------------------------------------------------------
# 8. 大体积成品与压缩包（默认不入库，见 README §4.3）
# -----------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.mp4
*.mov
*.avi
*.mkv
*.mp3
*.wav
